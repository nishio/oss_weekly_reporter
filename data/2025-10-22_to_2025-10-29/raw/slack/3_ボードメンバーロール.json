                "elements": [
                  {
                    "type": "text",
                    "text": "決済情報を入れると無料枠が増える（添付画像参照）"
                  }
                ]
              }
            ],
            "style": "bullet",
            "indent": 2,
            "border": 0
          },
          {
            "type": "rich_text_section",
            "elements": [
              {
                "type": "text",
                "text": "という構成でデプロイしたく\n"

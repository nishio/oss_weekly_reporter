            ],
            "style": "bullet",
            "indent": 0,
            "border": 0
          },
          {
            "type": "rich_text_list",
            "elements": [
              {
                "type": "rich_text_section",
                "elements": [
                  {
                    "type": "text",
                    "text": "デプロイ先：Deno Deploy"

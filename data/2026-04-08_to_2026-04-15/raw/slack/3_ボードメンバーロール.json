                            },
                            {
                              "type": "text",
                              "text": " さん（大柴さんの業務を引き継いだため）"
                            }
                          ]
                        },
                        {
                          "type": "rich_text_section",
                          "elements": [
                            {
                              "type": "user",
                              "user_id": "U08HWJ80CHG"
                            },
                            {
